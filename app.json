{
  "expo": {
    "name": "Bus Buddy",
    "slug": "bus-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.idandagan.buswake",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Bus Buddy sets an alarm so you wake up before your stop, even if your phone is on silent."
      },
      "appleTeamId": "3QVR465A88"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bus Wake uses your location in the background to wake you up before your stop.",
          "locationWhenInUsePermission": "Bus Wake uses your location to save stops and show how far away you are.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/beacon.wav",
            "./assets/sounds/rise.wav",
            "./assets/sounds/marimba.wav",
            "./assets/sounds/pulse.wav",
            "./assets/sounds/bells.wav",
            "./assets/sounds/silent.wav"
          ],
          "enableRemoteNotifications": false
        }
      ],
      "expo-asset",
      [
        "expo-router",
        {
          "origin": "https://bus-buddy.expo.app"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "busbuddy",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8371f6fd-aadc-4eee-b342-a51ea0f9a10f"
      }
    },
    "owner": "idandagan1"
  }
}
